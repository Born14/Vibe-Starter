# App URL (used for OAuth callbacks)
# Update this to your actual domain (e.g., https://yourdomain.com)
NEXT_PUBLIC_APP_URL=https://vibestarter.net

# Database (Neon PostgreSQL)
# Get from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/database

# Encryption key for sensitive data (at least 32 characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# GitHub OAuth (for wizard setup flow)
# Create at: https://github.com/settings/developers
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel OAuth (for wizard setup flow)
# Create at: https://vercel.com/dashboard/integrations
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/vercel/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=vibe-starter

# Clerk (optional - for protecting admin routes)
# Get from: https://dashboard.clerk.com
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
